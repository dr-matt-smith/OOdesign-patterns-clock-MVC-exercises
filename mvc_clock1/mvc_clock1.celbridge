[celbridge]
celbridge-version = "1.5.0"
project-version = "0.1.0"
features = { "editor-zoom-controls" = true }

[celbridge.resources]
hide = [".gitignore", ".DS_Store", "Thumbs.db", "desktop.ini", "deno.lock"]
search-exclude = ["node_modules"]

[[shortcut]]
resource = "terminal.console"
icon = "bs-terminal"
area = "bottom"
open-on-load = true

[[shortcut]]
resource = "dist/index.html"
icon = "bs-window"
area = "side"
open-on-load = true

[[shortcut]]
resource = "test_output/index.html"
icon = "bs-clipboard-check"
area = "side"

[[shortcut]]
resource = "README.md"
icon = "bs-book"
open-on-load = true
